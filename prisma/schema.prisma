generator client {
    provider = "prisma-client"
    // output   = "../generated/prisma"
    output   = "../src/generated"
    // moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

// Enums 
enum UserRole {
    SUPER_ADMIN
    ADMIN
    TEACHER
    STUDENT
    PRINCIPAL
    MANAGEMENT_STAFF
    ACCOUNTANT
    STORE_MANAGER
    LIBRARIAN
    OTHER
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

enum BloodGroup {
    A_POSITIVE
    A_NEGATIVE
    B_POSITIVE
    B_NEGATIVE
    AB_POSITIVE
    AB_NEGATIVE
    O_POSITIVE
    O_NEGATIVE
}

enum Religion {
    ISLAM
    HINDUISM
    CHRISTIANITY
    BUDDHISM
    OTHER
}

enum AddressType {
    PRESENT
    PERMANENT
}

enum EmployeeRole {
    PRINCIPAL
    MANAGEMENT_STAFF
    TEACHER
    ACCOUNTANT
    STORE_MANAGER
    LIBRARIAN
    OTHER
}

enum UserStatus {
    ACTIVE
    BLOCKED
    DELETED
}

model User {
    id                 String     @id
    name               String
    email              String
    role               UserRole   @default(STUDENT)
    status             UserStatus @default(ACTIVE)
    needPasswordChange Boolean    @default(false)
    isDeleted          Boolean    @default(false)
    deletedAt          DateTime?
    emailVerified      Boolean    @default(false)
    image              String?
    createdAt          DateTime   @default(now())
    updatedAt          DateTime   @updatedAt
    sessions           Session[]
    accounts           Account[]
    employee           Employee?
    admin              Admin?
    students           Student[]

    @@unique([email])
    @@map("user")
}

model Session {
    id        String   @id
    expiresAt DateTime
    token     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([token])
    @@index([userId])
    @@map("session")
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@index([userId])
    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
    @@map("verification")
}

model Admin {
    id            String    @id @default(uuid())
    name          String
    email         String    @unique
    profilePhoto  String?
    contactNumber String?
    isDeleted     Boolean   @default(false)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    deletedAt     DateTime?

    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([email])
    @@index([isDeleted])
    @@map("admins")
}

model Employee {
    id     String @id @default(uuid())
    userId String @unique

    phone String

    fullName         String
    nid              String
    fatherName       String
    motherName       String
    emergencyContact String?
    monthlySalary    Float
    employeeId       String  @unique

    picture         String?
    picturePublicId String?
    pictureName     String?
    pictureType     String?

    experience         String?
    experiencePublicId String?
    experienceName     String?
    experienceType     String?

    authoritySign         String
    authoritySignPublicId String
    authoritySignName     String?
    authoritySignType     String?

    employeeSign         String
    employeeSignPublicId String
    employeeSignName     String?
    employeeSignType     String?

    gender        Gender
    bloodGroup    BloodGroup
    religion      Religion
    employeeRole  UserRole   @default(OTHER)
    dateOfJoining String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    isdeleted Boolean   @default(false)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    address Address?
    classes Class[]

    @@map("employee")
}

// model TutorProfile {
//     id String @id @default(uuid())

//     classId    String

//     class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
//     employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
// }

model Class {
    id                String @id @default(uuid())
    name              String
    monthlyTuitionFee Float
    classTeacher      String

    isDeleted Boolean   @default(false)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    employee Employee  @relation(fields: [classTeacher], references: [id], onDelete: Cascade)
    students Student[]

    @@map("class")
}

model Address {
    id String @id @default(uuid())

    studentId  String? @unique @map("student_id")
    employeeId String? @unique @map("employee_id")

    permanentAddressVillage    String?
    permanentAddressPostOffice String?
    permanentAddressPostCode   String?
    permanentAddressDistrict   String?

    presentAddressVillage    String?
    presentAddressPostOffice String?
    presentAddressPostCode   String?
    presentAddressDistrict   String?

    isDeleted Boolean @default(false)

    student  Student?  @relation(fields: [studentId], references: [id])
    employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")
}

model Sequence {
    id      String @id
    current Int
}

model GuardianInfo {
    id             String @id @default(uuid())
    studentId      String @unique
    whatsappNumber String

    fatherName         String
    fatherNameBangla   String
    fatherMobileNumber String
    fatherOccupation   String

    motherName         String
    motherNameBangla   String
    motherMobileNumber String
    motherOccupation   String

    nameOfLocalGuardian   String
    relationShipOfStudent String
    GuardianMobileNumber  String

    student Student @relation(fields: [studentId], references: [id])

    isdeleted Boolean   @default(false)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}

model Student {
    id                      String      @id @default(uuid())
    userId                  String
    classId                 String
    studentId               String      @unique
    fullName                String
    fullNameBangla          String
    dateOfBirth             String
    birthRegistrationNumber String      @unique
    religion                Religion
    admissionTotalFees      Int
    admissionDate           String
    gender                  Gender
    bloodGroup              BloodGroup?
    previousInstituteName   String?
    endingClass             String?
    result                  String?
    testimonialNumber       String?

    studentSign         String
    studentSignPublicId String
    studentsignName     String
    studentSignType     String

    authoritySign         String
    authoritySignPublicId String
    authoritySignName     String?
    authoritySignType     String?

    guardianSign         String
    guardianSignPublicId String?
    guardianSignName     String?
    guardianSignType     String?

    picture         String
    picturePublicId String?
    pictureName     String?
    pictureType     String?

    address      Address?
    guardianInfo GuardianInfo?
    class        Class         @relation(fields: [classId], references: [id])
    user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

    isdeleted Boolean   @default(false)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}

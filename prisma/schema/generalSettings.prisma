model BankInfo {
    id            String  @id @default(uuid())
    nameOfBank    String
    branchAddress String
    accountNumber String
    instruction   String?

    bankLogo         String
    bankLogoPublicId String
    bankLogoName     String
    bankLogoType     String

    isDeleted Boolean   @default(false)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}

<% var minutes = (typeof expiryMinutes !== 'undefined' && expiryMinutes) ?
expiryMinutes : 2; var brand = (typeof appName !== 'undefined' && appName) ?
appName : 'GreenFair Kindergarten'; %>
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Your Verification Code</title>
        <style>
            body,
            table,
            td {
                -ms-text-size-adjust: 100%;
                -webkit-text-size-adjust: 100%;
            }

            body {
                margin: 0;
                padding: 0;
                width: 100% !important;
            }

            .otp-code {
                letter-spacing: 10px;
            }

            @media only screen and (max-width: 600px) {
                .container {
                    width: 100% !important;
                }

                .px {
                    padding-left: 20px !important;
                    padding-right: 20px !important;
                }

                .otp-code {
                    font-size: 32px !important;
                    letter-spacing: 7px !important;
                }
            }
        </style>
    </head>

    <body style="margin: 0; padding: 0; background-color: #f4f7f5">
        <!-- Preview Text -->
        <div
            style="
                display: none;
                max-height: 0;
                overflow: hidden;
                mso-hide: all;
            "
        >
            Your GreenFair Kindergarten verification code expires in <%= minutes
            %> minutes.
        </div>

        <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="background-color: #f4f7f5"
        >
            <tr>
                <td align="center" style="padding: 35px 15px">
                    <table
                        role="presentation"
                        class="container"
                        width="560"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="
                            width: 560px;
                            max-width: 560px;
                            background-color: #ffffff;
                            border: 1px solid #e3ebe5;
                            border-radius: 14px;
                            overflow: hidden;
                        "
                    >
                        <!-- Header -->
                        <tr>
                            <td
                                align="center"
                                style="
                                    padding: 30px 20px 25px;
                                    background-color: #f7faf8;
                                    border-bottom: 1px solid #e5ebe7;
                                "
                            >
                                <img
                                    src="https://res.cloudinary.com/k0llqgut/image/upload/v1794476262/greenfairlogo.png"
                                    alt="GreenFair Kindergarten Logo"
                                    width="100"
                                    style="
                                        display: block;
                                        width: 100px;
                                        max-width: 100%;
                                        height: auto;
                                        margin: 0 auto 14px;
                                    "
                                />

                                <h2
                                    style="
                                        margin: 0;
                                        color: #145c38;
                                        font-family:
                                            Arial, Helvetica, sans-serif;
                                        font-size: 22px;
                                        font-weight: 700;
                                    "
                                >
                                    GreenFair Kindergarten
                                </h2>

                                <p
                                    style="
                                        margin: 8px 0 0;
                                        color: #718078;
                                        font-family: Arial, sans-serif;
                                        font-size: 12px;
                                        letter-spacing: 1.5px;
                                        text-transform: uppercase;
                                    "
                                >
                                    Secure Sign-In
                                </p>
                            </td>
                        </tr>

                        <!-- Main Content -->
                        <tr>
                            <td class="px" style="padding: 38px 40px 35px">
                                <h2
                                    style="
                                        margin: 0 0 15px;
                                        color: #202b25;
                                        font-family: Georgia, serif;
                                        font-size: 26px;
                                        line-height: 34px;
                                        text-align: center;
                                    "
                                >
                                    Verify it's you
                                </h2>

                                <p
                                    style="
                                        margin: 0 0 28px;
                                        color: #5b6479;
                                        font-family: Arial, sans-serif;
                                        font-size: 15px;
                                        line-height: 25px;
                                        text-align: center;
                                    "
                                >
                                    Hello
                                    <strong style="color: #145c38"
                                        ><%= name %></strong
                                    >,
                                    <br />
                                    Use the verification code below to complete
                                    your requested action.
                                </p>

                                <!-- OTP Box -->
                                <table
                                    role="presentation"
                                    align="center"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="
                                        border: 1px dashed #197344;
                                        border-radius: 12px;
                                        background-color: #f3f8f4;
                                    "
                                >
                                    <tr>
                                        <td
                                            align="center"
                                            style="padding: 22px 30px"
                                        >
                                            <span
                                                class="otp-code"
                                                style="
                                                    font-family:
                                                        Consolas, Monaco,
                                                        &quot;Courier New&quot;,
                                                        monospace;
                                                    font-size: 40px;
                                                    font-weight: 700;
                                                    color: #145c38;
                                                    letter-spacing: 10px;
                                                "
                                            >
                                                <%= otp %>
                                            </span>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Expiration -->
                                <p
                                    style="
                                        margin: 22px 0 0;
                                        color: #c47b25;
                                        font-family: Arial, sans-serif;
                                        font-size: 14px;
                                        font-weight: 700;
                                        text-align: center;
                                    "
                                >
                                    Expires in <%= minutes %> minutes
                                </p>

                                <hr
                                    style="
                                        border: none;
                                        border-top: 1px solid #e5ebe7;
                                        margin: 30px 0 22px;
                                    "
                                />

                                <!-- Security Notice -->
                                <p
                                    style="
                                        margin: 0;
                                        color: #7b857e;
                                        font-family: Arial, sans-serif;
                                        font-size: 13px;
                                        line-height: 22px;
                                        text-align: center;
                                    "
                                >
                                    Didn't request this code? You can safely
                                    ignore this email. Never share your
                                    verification code with anyone.
                                </p>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td
                                align="center"
                                style="
                                    padding: 22px 20px;
                                    background-color: #f7faf8;
                                    border-top: 1px solid #e5ebe7;
                                "
                            >
                                <p
                                    style="
                                        margin: 0 0 8px;
                                        color: #145c38;
                                        font-family: Arial, sans-serif;
                                        font-size: 14px;
                                        font-weight: 700;
                                    "
                                >
                                    <%= brand %>
                                </p>

                                <p
                                    style="
                                        margin: 0;
                                        color: #89938c;
                                        font-family: Arial, sans-serif;
                                        font-size: 12px;
                                        line-height: 20px;
                                    "
                                >
                                    This is an automated email. Please do not
                                    reply.
                                    <br />
                                    &copy; <%= new Date().getFullYear() %> <%=
                                    brand %>. All rights reserved.
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>

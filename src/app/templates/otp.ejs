<% var minutes = (typeof expiryMinutes !== 'undefined' && expiryMinutes) ?
expiryMinutes : 2; %> <% var brand = (typeof appName !== 'undefined' && appName)
? appName : 'School Management System'; %>
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Your verification code</title>
        <style>
            body,
            table,
            td {
                -ms-text-size-adjust: 100%;
                -webkit-text-size-adjust: 100%;
            }
            body {
                margin: 0;
                padding: 0;
                width: 100% !important;
            }
            .otp-code {
                letter-spacing: 10px;
            }
            @media only screen and (max-width: 600px) {
                .container {
                    width: 100% !important;
                }
                .px {
                    padding-left: 24px !important;
                    padding-right: 24px !important;
                }
                .otp-code {
                    font-size: 32px !important;
                    letter-spacing: 7px !important;
                }
            }
        </style>
    </head>
    <body style="margin: 0; padding: 0">
        <div
            style="
                display: none;
                max-height: 0;
                overflow: hidden;
                mso-hide: all;
            "
        >
            Your one-time code expires in <%= minutes %>
            minutes&#8203;&#8203;&#8203;&#8203;&#8203;&#8203;&#8203;&#8203;
        </div>

        <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
        >
            <tr>
                <td align="center" style="padding: 32px 16px">
                    <table
                        role="presentation"
                        class="container"
                        width="560"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="width: 560px; max-width: 560px"
                    >
                        <tr>
                            <td align="center" style="padding-bottom: 18px">
                                <span
                                    style="
                                        font-family:
                                            -apple-system, BlinkMacSystemFont,
                                            &quot;Segoe UI&quot;, Roboto,
                                            Helvetica, Arial, sans-serif;
                                        font-size: 12px;
                                        font-weight: 700;
                                        letter-spacing: 2px;
                                        color: #00504f;
                                        text-transform: uppercase;
                                    "
                                >
                                    Secure Sign-In
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td
                                class="px"
                                style="
                                    border: 1px solid #e3e7ef;
                                    border-radius: 16px;
                                    padding: 40px 40px 36px;
                                "
                            >
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                >
                                    <tr>
                                        <td
                                            align="center"
                                            style="
                                                font-family:
                                                    Georgia,
                                                    &quot;Times New Roman&quot;,
                                                    serif;
                                                font-size: 26px;
                                                line-height: 32px;
                                                color: #15203d;
                                                padding-bottom: 12px;
                                            "
                                        >
                                            Verify it's you
                                        </td>
                                    </tr>

                                    <tr>
                                        <td
                                            align="center"
                                            style="
                                                font-family:
                                                    -apple-system,
                                                    BlinkMacSystemFont,
                                                    &quot;Segoe UI&quot;,
                                                    Roboto, Helvetica, Arial,
                                                    sans-serif;
                                                font-size: 15px;
                                                line-height: 24px;
                                                color: #5b6479;
                                                padding-bottom: 28px;
                                            "
                                        >
                                            Hi <%= name %>, use the code below
                                            to finish resetting your password.
                                        </td>
                                    </tr>

                                    <tr>
                                        <td align="center">
                                            <table
                                                role="presentation"
                                                cellpadding="0"
                                                cellspacing="0"
                                                border="0"
                                                style="
                                                    border: 1px dashed #00504f;
                                                    border-radius: 12px;
                                                "
                                            >
                                                <tr>
                                                    <td
                                                        align="center"
                                                        style="
                                                            padding: 22px 36px;
                                                        "
                                                    >
                                                        <span
                                                            class="otp-code"
                                                            style="
                                                                font-family:
                                                                    &quot;SFMono-Regular&quot;,
                                                                    Consolas,
                                                                    &quot;Liberation Mono&quot;,
                                                                    Menlo,
                                                                    Courier,
                                                                    monospace;
                                                                font-size: 40px;
                                                                font-weight: 700;
                                                                color: #15203d;
                                                            "
                                                            ><%= otp %></span
                                                        >
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td
                                            align="center"
                                            style="
                                                font-family:
                                                    -apple-system,
                                                    BlinkMacSystemFont,
                                                    &quot;Segoe UI&quot;,
                                                    Roboto, Helvetica, Arial,
                                                    sans-serif;
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: #c9711f;
                                                padding: 20px 0 4px;
                                            "
                                        >
                                            Expires in <%= minutes %> minutes
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="padding: 28px 0 20px">
                                            <hr
                                                style="
                                                    border: none;
                                                    border-top: 1px solid
                                                        #e3e7ef;
                                                    margin: 0;
                                                "
                                            />
                                        </td>
                                    </tr>

                                    <tr>
                                        <td
                                            align="center"
                                            style="
                                                font-family:
                                                    -apple-system,
                                                    BlinkMacSystemFont,
                                                    &quot;Segoe UI&quot;,
                                                    Roboto, Helvetica, Arial,
                                                    sans-serif;
                                                font-size: 13px;
                                                line-height: 20px;
                                                color: #8893b5;
                                            "
                                        >
                                            Didn't request this? You can safely
                                            ignore this email — your password
                                            won't be changed.
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <tr>
                            <td align="center" style="padding: 28px 16px 0">
                                <span
                                    style="
                                        font-family:
                                            -apple-system, BlinkMacSystemFont,
                                            &quot;Segoe UI&quot;, Roboto,
                                            Helvetica, Arial, sans-serif;
                                        font-size: 12px;
                                        color: #9aa3bd;
                                    "
                                >
                                    &copy; <%= new Date().getFullYear() %> <%=
                                    brand %>. This is an automated message,
                                    please don't reply.
                                </span>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
